# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# --- Binance testnet (free, virtual funds) ---
# Get keys: https://testnet.binance.vision/  (login with GitHub)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Binance mainnet (real money) ---
# Only fill these in when you are ready to trade real funds.
# Create keys: https://www.binance.com/en/my/settings/api-management
# Recommended: enable IP whitelist, disable withdrawals.
# BINANCE_MAINNET_KEY=
# BINANCE_MAINNET_SECRET=

# --- Telegram notifications ---
# 1. Talk to @BotFather in Telegram -> /newbot -> copy the token
# 2. Talk to @userinfobot -> copy your numeric chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=