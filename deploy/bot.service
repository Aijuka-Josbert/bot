[Unit]
Description=Trading Bot (paper mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot@josbert.service
WorkingDirectory=/home/%i/Desktop/bot
EnvironmentFile=/home/%i/Desktop/bot/.env
Environment=PYTHONUNBUFFERED=1

# --ticks 0 means run forever
ExecStart=/home/%i/Desktop/bot/.venv/bin/bot-run \
    --config /home/%i/Desktop/bot/config.yaml \
    --ticks 0 \
    --poll 60 \
    --heartbeat 300

Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bot

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target